# Vite retains source HTML line endings. Keep committed web builds identical on Windows/Linux.
frontend/index.html text eol=lf
static/dist/*.html text eol=lf
static/dist/*.js text eol=lf
static/dist/*.css text eol=lf
static/dist/*.txt text eol=lf
tests/fixtures/listenbrainz/*.jsonl text eol=lf
# The Ask schema is compared byte-for-byte with the generated LF text.
src/ask/schema/*.json text eol=lf
