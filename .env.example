# Optional. Spotify credentials can also be entered in the local web interface.
# Environment values override web configuration; restart after changing this file.
SCROBBL_PORT=3210
SCROBBL_DATA_DIR=./data
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Server-side collection interval, in seconds (minimum 60).
SCROBBL_SYNC_SECONDS=120
# Now playing is fetched only while an authenticated browser is open (minimum 15).
SCROBBL_NOW_PLAYING_SECONDS=30

# Durable Spotify imports, byte limits before/after ZIP expansion and per member/row.
# SCROBBL_IMPORT_UPLOAD_BYTES=268435456
# SCROBBL_IMPORT_EXPANDED_BYTES=1073741824
# SCROBBL_IMPORT_MEMBER_BYTES=268435456
# SCROBBL_IMPORT_ROW_BYTES=2097152
# SCROBBL_IMPORT_FILES=10000
