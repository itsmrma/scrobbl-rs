# Optional. Spotify credentials can also be entered in the local web interface.
# Environment values override web configuration; restart after changing this file.
SCROBBL_PORT=3210
# Internal listening IP; containers use 0.0.0.0. A non-loopback bind requires an origin.
SCROBBL_BIND=127.0.0.1
# Browser-facing origin (scheme, name, optional port; no path).
# SCROBBL_EXTERNAL_ORIGIN=https://music.example.org
SCROBBL_DATA_DIR=./data
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Legacy initial default only. Prefer Settings > Connections > Refresh intervals.
# Saved server settings override these values without a restart (collection minimum 60).
SCROBBL_SYNC_SECONDS=120
# Now playing initial default (minimum 15); saved Settings take precedence.
SCROBBL_NOW_PLAYING_SECONDS=30

# Durable Spotify imports, byte limits before/after ZIP expansion and per member/row.
# SCROBBL_IMPORT_UPLOAD_BYTES=268435456
# SCROBBL_IMPORT_EXPANDED_BYTES=1073741824
# SCROBBL_IMPORT_MEMBER_BYTES=268435456
# SCROBBL_IMPORT_ROW_BYTES=2097152
# SCROBBL_IMPORT_FILES=10000

# Read API coherent-copy quotas, shared with other snapshot users.
# SCROBBL_API_MAX_COPIES=4
# SCROBBL_API_COPY_BYTES=2147483648
# SCROBBL_API_COPY_TTL_SECONDS=900
# SCROBBL_API_COPY_TIMEOUT_SECONDS=60

# ListenBrainz file limits (shown in Import history).
# SCROBBL_LB_UPLOAD_BYTES=536870912
# SCROBBL_LB_EXPANDED_BYTES=2147483648
# SCROBBL_LB_MEMBERS=10000
# SCROBBL_LB_ROW_BYTES=1048576
